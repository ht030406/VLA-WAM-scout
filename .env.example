# ===== vla-wam-scout 环境变量模板 =====
# 复制为 .env 并填入真实值：cp .env.example .env

# --- LLM（灵枢 / OpenAI 兼容）---
# 灵枢 API key（可在 DSH 的 ~/.dsh/.credentials.yaml refs 中查看）
LINGSHU_API_KEY=
LINGSHU_BASE_URL=https://computing.huawei.com/lingshu/api/v1
LINGSHU_MODEL=DeepSeek-V4-Flash-0731
# 自签 CA 证书路径（灵枢链）。留空则用系统证书。
CA_CERT_FILE=/root/.certs/lingshu_chain.pem

# --- GitHub ---
# 可选：GitHub Personal Access Token，可显著提升搜索 API 限额（无 token 10 req/min）
GITHUB_TOKEN=
GITHUB_MIN_STARS=0

# --- 采集窗口 ---
LOOKBACK_DAYS=2
ARXIV_MAX_RESULTS=60

# --- 高级（可不动）---
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3
GITHUB_SEARCH_PER_PAGE=12
GITHUB_MAX_REPOS=25
HF_MAX_MODELS=25

# --- 跨日去重（可不动）---
# 论文去重窗口（天）
DEDUP_DAYS_PAPER=14
# 仓库去重窗口（天）
DEDUP_DAYS_REPO=7
# 模型去重窗口（天）
DEDUP_DAYS_MODEL=30
# star 飙升重报阈值：相对增长 ≥50% 或绝对增长 ≥200 即重新报道
STAR_SURGE_REL=0.5
STAR_SURGE_ABS=200
