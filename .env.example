# ===== vla-wam-scout 环境变量模板 =====
# 复制为 .env 并填入真实值：cp .env.example .env

# --- LLM（OpenAI 兼容；默认 ModelScope 公网接口）---
# ModelScope 访问令牌（GitHub Actions 仓库 secret 也用同一个，与 daily-arxiv-vla 一致）
LLM_API_KEY=
# OpenAI 兼容端点；如需用灵枢请改为其公网网关（内网域名 GitHub runner 无法解析）
LLM_BASE_URL=https://api-inference.modelscope.cn/v1/
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# 备用模型（逗号分隔）：主模型失败/限流时依次尝试，可留空
LLM_FALLBACK_MODELS=ZhipuAI/GLM-5.3-Flash,moonshotai/Kimi-K3
# 自定义 CA 证书：仅内部网关（如灵枢）需要；公网端点留空用系统证书
CA_CERT_FILE=

# --- GitHub ---
# 可选：GitHub Personal Access Token，可显著提升搜索 API 限额（无 token 10 req/min）
GITHUB_TOKEN=
GITHUB_MIN_STARS=0

# --- 采集窗口 ---
LOOKBACK_DAYS=2
ARXIV_MAX_RESULTS=60

# --- 高级（可不动）---
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3
GITHUB_SEARCH_PER_PAGE=12
GITHUB_MAX_REPOS=25
HF_MAX_MODELS=25

# --- 跨日去重（可不动）---
# 论文去重窗口（天）
DEDUP_DAYS_PAPER=14
# 仓库去重窗口（天）
DEDUP_DAYS_REPO=7
# 模型去重窗口（天）
DEDUP_DAYS_MODEL=30
# star 飙升重报阈值：相对增长 ≥50% 或绝对增长 ≥200 即重新报道
STAR_SURGE_REL=0.5
STAR_SURGE_ABS=200
